# Copy this to .env for local development (not committed to git)

# Flask session secret - use a long random string in production
SECRET_KEY=change-this-to-a-random-string

# Admin dashboard password
ADMIN_PASSWORD=change-this-password

# Database URL - leave unset to use local SQLite (registry.db)
# For production, use your Supabase/Postgres connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
